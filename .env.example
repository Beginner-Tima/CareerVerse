# --- CareerVerse Backend (NestJS + Prisma) ---
# Скопируйте в .env и заполните своими значениями:  cp .env.example .env

# PostgreSQL. Локально — Homebrew Postgres или `docker compose up -d`.
# На проде — пулер Supabase (Supavisor), НЕ прямое подключение: прямой хост
# db.<ref>.supabase.co доступен только по IPv6, а Vercel ходит по IPv4.
#   приложение:  ...pooler.supabase.com:6543  (transaction mode)
#   миграции:    ...pooler.supabase.com:5432  (session mode)
DATABASE_URL="postgresql://USER@localhost:5432/careerverse?schema=public"

# Корневой сертификат Supabase (PEM целиком). Без него соединение шифруется,
# но сертификат сервера не проверяется — приложение об этом предупредит в логах.
# Скачать: https://supabase-downloads.s3.amazonaws.com/prod/ssl/prod-ca-2021.crt
SUPABASE_CA_CERT=""

# Домены фронта через запятую. Пусто = разрешить всем (только для локальной разработки).
CORS_ORIGINS=""

# Секрет для подписи токенов доступа (HS256).
# Внимание: Supabase Auth в продукте сейчас НЕ используется — логина нет, а токены
# для защищённых эндпоинтов мы подписываем сами. Поэтому сюда идёт просто случайная
# строка: openssl rand -hex 32
# Когда появится настоящий вход через Supabase, этот путь придётся переписать:
# проекты, созданные после октября 2025, подписывают токены асимметрично (ES256)
# и отдают ключи через JWKS, а общего HS256-секрета у них нет.
SUPABASE_JWT_SECRET="change-me"

# Порт HTTP-сервера. 3000 занят системой ИИ-агентов (ruflo) — держите их разными.
PORT=3000

# Claude API → console.anthropic.com → Settings → API keys.
# Без него слой ИИ не поднимется: у теста нет ключа ответов, оценивает модель.
ANTHROPIC_API_KEY=""
# Модель по умолчанию. Haiku 4.5 — самая дешёвая из актуальных.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
